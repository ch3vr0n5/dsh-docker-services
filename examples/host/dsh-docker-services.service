[Unit]
Description=DeepSeek Harness Docker Services controller
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=dsh-controller
Group=dsh-controller
ExecStart=/usr/local/bin/dsh-docker-services-controller /etc/dsh-docker-services/controller.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dsh-docker-services /var/lib/dsh-audit-checkpoint /run/dsh-docker-services
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
