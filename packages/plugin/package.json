{
  "name": "dsh-docker-services",
  "version": "0.1.0",
  "description": "Guarded service and deployment controls for DeepSeek Harness Docker controllers",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {".": {"types": "./lib/index.d.ts", "default": "./lib/index.js"}, "./client": {"types": "./lib/client.d.ts", "default": "./lib/client.js"}, "./package.json": "./package.json"},
  "files": ["lib/src/**/*.js", "lib/src/**/*.d.ts", "README.md", "LICENSE", "cordis.patch.yml"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"]}},
  "scripts": {"build": "tsc -b"},
  "dependencies": {"@deepseek-ai/schemastery": "3.18.1"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0",
    "dsh-dashboard": ">=0.7.0 <0.8.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "dsh-dashboard": "0.7.0",
    "react": "18.3.1"
  },
  "engines": {"node": "^22.19.0 || >=24.0.0"},
  "license": "Apache-2.0",
  "publishConfig": {"access": "public"}
}
